INTERLIS 2.3;

/** Ein minimales Beispielmodell für das erste Tutorial.
    Ein Thema "Bodenbedeckung" mit einer Klasse "Gebaeude",
    die einfache Attribute und eine Geometrie besitzt.
**/

MODEL DemoBodenbedeckung (de)
AT "https://github.com/edigonzales/hop-interlis-plugin"
VERSION "2024-01-01" =

  DOMAIN
    Coord2 = COORD
      2000000.000 .. 3000000.000,
      1000000.000 .. 1400000.000;

  TOPIC Bodenbedeckung =

    CLASS Gebaeude =
      Name : TEXT*100;
      Art : (
        Wohngebaeude,
        Gewerbegebaeude,
        Oeffentliches_Gebaeude,
        Sonstiges
      );
      Geometrie : SURFACE WITH (ARCS, STRAIGHTS)
        VERTEX Coord2 WITHOUT OVERLAPS > 0.001;
    END Gebaeude;

  END Bodenbedeckung;

END DemoBodenbedeckung.
