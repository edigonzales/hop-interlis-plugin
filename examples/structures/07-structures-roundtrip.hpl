      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>INTERLIS Input</from>
      <to>INTERLIS Structure Explode</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>INTERLIS Input</from>
      <to>INTERLIS Structure Collect</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>INTERLIS Structure Explode</from>
      <to>INTERLIS Structure Collect</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>INTERLIS Structure Collect</from>
      <to>INTERLIS Output</to>
