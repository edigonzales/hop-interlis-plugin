<?xml version='1.0' encoding='utf-8'?>
<pipeline>
  <info>
    <name>child-preserve</name>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>E2E_INPUT_DIR</name>
        <default_value />
        <description>Lokales Fixture-Verzeichnis</description>
      </parameter>
      <parameter>
        <name>E2E_OUTPUT_DIR</name>
        <default_value />
        <description>Vorhandenes Ausgabeverzeichnis</description>
      </parameter>
    </parameters>
  </info>
  <transform>
    <name>input</name>
    <type>INTERLIS_INPUT</type>
    <modelNames>DemoErhaltung</modelNames>
    <modelDirectories>${E2E_INPUT_DIR}</modelDirectories>
    <className>DemoErhaltung.Daten.Eltern</className>
    <fileName>${E2E_INPUT_DIR}/erhaltung-transfer.xtf</fileName>
    <includeTid>Y</includeTid>
    <includeBid>Y</includeBid>
    <keepSourceObject>Y</keepSourceObject>
    <sourceObjectFieldName>_ili_source_object</sourceObjectFieldName>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>parents0</name>
    <type>Dummy</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>300</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>children0</name>
    <type>INTERLIS_STRUCTURE_EXPLODE</type>
    <modelNames>DemoErhaltung</modelNames>
    <modelDirectories>${E2E_INPUT_DIR}</modelDirectories>
    <className>DemoErhaltung.Daten.Eltern</className>
    <structureAttributePath>Kinder</structureAttributePath>
    <sourceObjectField>_ili_source_object</sourceObjectField>
    <parentTidField>_ili_tid</parentTidField>
    <parentBidField>_ili_bid</parentBidField>
    <emitParentBid>Y</emitParentBid>
    <emitIndexForBag>Y</emitIndexForBag>
    <parentKeyFieldName>_ili_parent_tid</parentKeyFieldName>
    <parentBidKeyFieldName>_ili_parent_bid</parentBidKeyFieldName>
    <indexFieldName>_ili_index</indexFieldName>
    <keep_child_source_object>Y</keep_child_source_object>
    <selectedChildFields>Name</selectedChildFields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>500</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>collect0</name>
    <type>INTERLIS_STRUCTURE_COLLECT</type>
    <modelNames>DemoErhaltung</modelNames>
    <modelDirectories>${E2E_INPUT_DIR}</modelDirectories>
    <className>DemoErhaltung.Daten.Eltern</className>
    <structureAttributePath>Kinder</structureAttributePath>
    <sourceObjectField>_ili_source_object</sourceObjectField>
    <parentInputTransform>parents0</parentInputTransform>
    <childInputTransform>Behalten</childInputTransform>
    <parentKeyField>_ili_tid</parentKeyField>
    <childParentKeyField>_ili_parent_tid</childParentKeyField>
    <childIndexField>_ili_index</childIndexField>
    <parent_bid_field>_ili_bid</parent_bid_field>
    <child_parent_bid_field>_ili_parent_bid</child_parent_bid_field>
    <collect_mode>PRESERVE</collect_mode>
    <strictOrdering>Y</strictOrdering>
    <failOnDuplicateIndex>Y</failOnDuplicateIndex>
    <failOnChildWithoutParent>Y</failOnChildWithoutParent>
    <bufferMemoryMiB>64</bufferMemoryMiB>
    <spillDirectory />
    <maxSpillMiB>0</maxSpillMiB>
    <selectedChildFields>Name</selectedChildFields>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>700</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <order>
    <hop>
      <from>input</from>
      <to>parents0</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>input</from>
      <to>children0</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>parents0</from>
      <to>collect0</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>children0</from>
      <to>Behalten</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>collect0</from>
      <to>output</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Behalten</from>
      <to>collect0</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Behalten</from>
      <to>Entfernen</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>output</name>
    <type>INTERLIS_OUTPUT</type>
    <modelNames>DemoErhaltung</modelNames>
    <modelDirectories>${E2E_INPUT_DIR}</modelDirectories>
    <className>DemoErhaltung.Daten.Eltern</className>
    <fileName>${E2E_OUTPUT_DIR}/doc-erhaltung.xtf</fileName>
    <objectIdField>_ili_tid</objectIdField>
    <basketIdField>_ili_bid</basketIdField>
    <basketId>b1</basketId>
    <sourceObjectField>_ili_source_object</sourceObjectField>
    <overwrite>Y</overwrite>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>900</xloc>
      <yloc>100</yloc>
    </GUI>
    <validateBeforePublish>Y</validateBeforePublish>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Behalten</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>Name</leftvalue>
        <function>=</function>
        <value>
          <name>value</name>
          <type>String</type>
          <text>bleibt</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
        <conditions />
      </condition>
    </compare>
    <send_true_to>collect0</send_true_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>260</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
    <send_false_to>Entfernen</send_false_to>
  </transform>
  <transform>
    <name>Entfernen</name>
    <type>Dummy</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>300</xloc>
      <yloc>260</yloc>
    </GUI>
  </transform>
</pipeline>
