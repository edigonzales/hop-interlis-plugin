<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ch.so.agi</groupId>
    <artifactId>hop-interlis-plugin-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>hop-interlis-core</artifactId>
  <name>Apache Hop INTERLIS Core</name>
  <description>INTERLIS model, transfer and geometry logic without SWT or Hop runtime dependencies.</description>

  <dependencies>
    <!-- Already supplied by Hop core. No second JSON implementation in the plugin ZIP. -->
    <dependency>
      <groupId>com.googlecode.json-simple</groupId><artifactId>json-simple</artifactId>
      <version>1.1.1</version><scope>provided</scope>
    </dependency>
    <!-- INTERLIS transfer I/O (XTF reader/writer, Iox2wkb/Wkb2iox). -->
    <dependency>
      <groupId>ch.interlis</groupId>
      <artifactId>iox-ili</artifactId>
    </dependency>
    <!-- INTERLIS model compiler: metamodel + TransferDescription. -->
    <dependency>
      <groupId>ch.interlis</groupId>
      <artifactId>ili2c-core</artifactId>
    </dependency>
    <!-- Model compilation entry points (Ili2c.Main.runCompiler) and repository support (IliManager). -->
    <dependency>
      <groupId>ch.interlis</groupId>
      <artifactId>ili2c-tool</artifactId>
    </dependency>
    <!-- Used directly to pass model directories into the compiler. -->
    <dependency>
      <groupId>ch.ehi</groupId>
      <artifactId>ehibasics</artifactId>
    </dependency>

    <!-- Shared Hop geometry representation; provided by hop-geometry-type-plugin at runtime. -->
    <dependency>
      <groupId>ch.so.agi</groupId>
      <artifactId>hop-geometry-type</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.locationtech.jts</groupId>
      <artifactId>jts-core</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
