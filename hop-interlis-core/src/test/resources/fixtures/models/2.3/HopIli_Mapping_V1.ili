INTERLIS 2.3;

/** Test model for row projection edge cases: name collisions, multi-valued structures/roles. */
MODEL HopIli_Mapping_V1 (en)
AT "https://hop.interlis.example/models" VERSION "2026-08-25" =
  DOMAIN
    Coord = COORD 2460000.000 .. 2870000.000, 1045000.000 .. 1310000.000;
  TOPIC Data =
    STRUCTURE Address =
      Street : TEXT*80;
      Number : TEXT*10;
    END Address;

    STRUCTURE Quality =
      Kind : TEXT*40;
      Level : 0 .. 100;
    END Quality;

    CLASS Collision =
      Address_Street : TEXT*40;
      Address : Address;
    END Collision;

    CLASS MultiStruct =
      Name : TEXT*40;
      Qualities : LIST OF Quality;
    END MultiStruct;

    CLASS Owner =
      Name : TEXT*40;
    END Owner;

    CLASS Item =
      Name : TEXT*40;
    END Item;

    ASSOCIATION OwnerItem =
      Owner_ -- {1} Owner;
      Item_ -- {0..*} Item;
    END OwnerItem;
  END Data;
END HopIli_Mapping_V1.
