INTERLIS 2.4;

TYPE MODEL GeometryCHLV95_V2 (en)
AT "https://hop.interlis.example/models" VERSION "2026-08-28" =
  DOMAIN
    Coord2 = COORD -1000.000 .. 1000.000, -1000.000 .. 1000.000;
    Coord3 = COORD -1000.000 .. 1000.000, -1000.000 .. 1000.000, -1000.000 .. 1000.000;
    MultiPoint = MULTICOORD -1000.000 .. 1000.000, -1000.000 .. 1000.000;
    MultiPoint3D = MULTICOORD -1000.000 .. 1000.000, -1000.000 .. 1000.000, -1000.000 .. 1000.000;
    MultiLine = MULTIPOLYLINE WITH (STRAIGHTS, ARCS) VERTEX Coord2;
    MultiDirectedLine = DIRECTED MULTIPOLYLINE WITH (STRAIGHTS, ARCS) VERTEX Coord2;
    MultiSurface = MULTISURFACE WITH (STRAIGHTS, ARCS) VERTEX Coord2 WITHOUT OVERLAPS > 0.001;
    MultiLineWithoutArcs = MULTIPOLYLINE WITH (STRAIGHTS) VERTEX Coord2;
    MultiDirectedLineWithoutArcs = DIRECTED MULTIPOLYLINE WITH (STRAIGHTS) VERTEX Coord2;
    MultiSurfaceWithoutArcs = MULTISURFACE WITH (STRAIGHTS) VERTEX Coord2 WITHOUT OVERLAPS > 0.001;
END GeometryCHLV95_V2.

MODEL HopIli_CHLV95_V2 (en)
AT "https://hop.interlis.example/models" VERSION "2026-08-28" =
  IMPORTS GeometryCHLV95_V2;

  TOPIC Data =
    CLASS TestObject =
      Points: GeometryCHLV95_V2.MultiPoint;
      Points3D: GeometryCHLV95_V2.MultiPoint3D;
      MLine: GeometryCHLV95_V2.MultiLine;
      MDirectedLine: GeometryCHLV95_V2.MultiDirectedLine;
      MPoly: GeometryCHLV95_V2.MultiSurface;
      MLinePlain: GeometryCHLV95_V2.MultiLineWithoutArcs;
      MDirectedLinePlain: GeometryCHLV95_V2.MultiDirectedLineWithoutArcs;
      MPolyPlain: GeometryCHLV95_V2.MultiSurfaceWithoutArcs;
    END TestObject;
  END Data;
END HopIli_CHLV95_V2.
