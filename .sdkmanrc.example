# Copy this file to .sdkmanrc and replace the value with the exact
# Java 21 SDKMAN identifier installed on the development machine.
#
# Discover installed JDKs with:
#   source "$HOME/.sdkman/bin/sdkman-init.sh"
#   sdk current java
#   sdk list java
#   ls -1 "$HOME/.sdkman/candidates/java"
#
# Example only; do not commit an identifier that is not actually available:
java=21.0.XX-tem
