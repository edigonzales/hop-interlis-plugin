<pipeline>
  <info>
    <name>45-prio3-structure-update</name>
    <pipeline_type>Normal</pipeline_type>
    <parameters />
    <size_rowset>1</size_rowset>
  </info>
  <transform>
    <name>items</name>
    <type>INTERLIS_INPUT</type>
    <modelNames>HopIli_Collections_V1</modelNames>
    <modelDirectories>${E2E_INPUT_DIR}</modelDirectories>
    <className>HopIli_Collections_V1.Data.Item</className>
    <fileName>${E2E_INPUT_DIR}/collections-spill.xtf</fileName>
    <includeTid>Y</includeTid>
    <includeBid>Y</includeBid>
    <selectFields>Y</selectFields>
    <keepSourceObject>Y</keepSourceObject>
    <sourceObjectFieldName>_ili_source_object</sourceObjectFieldName>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>children</name>
    <type>INTERLIS_STRUCTURE_EXPLODE</type>
    <modelNames>HopIli_Collections_V1</modelNames>
    <modelDirectories>${E2E_INPUT_DIR}</modelDirectories>
    <className>HopIli_Collections_V1.Data.Item</className>
    <structureAttributePath>Children</structureAttributePath>
    <sourceObjectField>_ili_source_object</sourceObjectField>
    <parentTidField>_ili_tid</parentTidField>
    <parentBidField>_ili_bid</parentBidField>
    <emit_update_reference>Y</emit_update_reference>
    <selectedChildFields>Hidden</selectedChildFields>
    <selectedChildFields>Payload</selectedChildFields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>350</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>output</name>
    <type>INTERLIS_UPDATE</type>
    <modelNames>HopIli_Collections_V1</modelNames>
    <modelDirectories>${E2E_INPUT_DIR}</modelDirectories>
    <fileName>${E2E_OUTPUT_DIR}/prio3-children.xtf</fileName>
    <overwrite>Y</overwrite>
    <validateBeforePublish>Y</validateBeforePublish>
    <bufferMemoryMiB>1</bufferMemoryMiB>
    <spillDirectory>${E2E_OUTPUT_DIR}</spillDirectory>
    <maxSpillMiB>64</maxSpillMiB>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>700</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
    </GUI>
    <originalFile>${E2E_INPUT_DIR}/collections-spill.xtf</originalFile>
    <inputs>
      <input>
        <transformName>children</transformName>
        <className>HopIli_Collections_V1.Data.Item</className>
        <objectIdField>_ili_tid</objectIdField>
        <basketIdField>_ili_bid</basketIdField>
        <structurePath>Children</structurePath>
        <updateReferenceField>_ili_update_ref</updateReferenceField>
        <fields>
          <field>
            <sourceField>Hidden</sourceField>
            <targetPath>Name</targetPath>
          </field>
          <field>
            <sourceField>Payload</sourceField>
            <targetPath>Payload</targetPath>
          </field>
        </fields>
      </input>
    </inputs>
  </transform>
  <order>
    <hop>
      <from>items</from>
      <to>children</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>children</from>
      <to>output</to>
      <enabled>Y</enabled>
    </hop>
  </order>
</pipeline>
