<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>04-interlis-to-gpkg</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/08/26 00:20:00.000</created_date>
    <modified_date>2026/08/26 00:20:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop>
      <from>INTERLIS Input</from>
      <to>Vector Writer</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>INTERLIS_INPUT</type>
    <name>INTERLIS Input</name>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fileName>${E2E_INPUT_DIR}/HopIli_Geometry_V1_arcs.xtf</fileName>
    <modelNames>%DATA</modelNames>
    <modelDirectories>${E2E_INPUT_DIR}</modelDirectories>
    <className>HopIli_Geometry_V1.Data.TestObject</className>
    <includeTid>Y</includeTid>
    <includeBid>Y</includeBid>
    <includeClassName>N</includeClassName>
    <includeTopicName>N</includeTopicName>
    <defaultSrid/>
    <attributes/>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <type>SOGIS_VECTOR_WRITER</type>
    <name>Vector Writer</name>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fileName>${E2E_OUTPUT_DIR}/interlis-arcs.gpkg</fileName>
    <layerName>buildings</layerName>
    <geometryField>Axis</geometryField>
    <attributes/>
    <GUI>
      <xloc>300</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform_error_handling/>
  <transform_order/>
  <transform_notes/>
</pipeline>
