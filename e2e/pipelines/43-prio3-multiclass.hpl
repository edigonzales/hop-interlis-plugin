<pipeline>
  <info>
    <name>43-prio3-multiclass</name>
    <pipeline_type>Normal</pipeline_type>
    <parameters />
    <size_rowset>1</size_rowset>
  </info>
  <transform>
    <name>targets</name>
    <type>INTERLIS_INPUT</type>
    <modelNames>HopIli_Collections_V1</modelNames>
    <modelDirectories>${E2E_INPUT_DIR}</modelDirectories>
    <className>HopIli_Collections_V1.Data.Target</className>
    <fileName>${E2E_INPUT_DIR}/collections-spill.xtf</fileName>
    <includeTid>Y</includeTid>
    <includeBid>Y</includeBid>
    <selectFields>Y</selectFields>
    <selectedFields>Name</selectedFields>
    <keepSourceObject>N</keepSourceObject>
    <sourceObjectFieldName>_ili_source_object</sourceObjectFieldName>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>items</name>
    <type>INTERLIS_INPUT</type>
    <modelNames>HopIli_Collections_V1</modelNames>
    <modelDirectories>${E2E_INPUT_DIR}</modelDirectories>
    <className>HopIli_Collections_V1.Data.Item</className>
    <fileName>${E2E_INPUT_DIR}/collections-spill.xtf</fileName>
    <includeTid>Y</includeTid>
    <includeBid>Y</includeBid>
    <selectFields>Y</selectFields>
    <keepSourceObject>Y</keepSourceObject>
    <sourceObjectFieldName>_ili_source_object</sourceObjectFieldName>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>260</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>target copies</name>
    <type>Dummy</type>
    <distribute>Y</distribute>
    <copies>3</copies>
    <GUI>
      <xloc>350</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>output</name>
    <type>INTERLIS_OUTPUT</type>
    <modelNames>HopIli_Collections_V1</modelNames>
    <modelDirectories>${E2E_INPUT_DIR}</modelDirectories>
    <fileName>${E2E_OUTPUT_DIR}/prio3-multi.xtf</fileName>
    <overwrite>Y</overwrite>
    <validateBeforePublish>Y</validateBeforePublish>
    <bufferMemoryMiB>1</bufferMemoryMiB>
    <spillDirectory>${E2E_OUTPUT_DIR}</spillDirectory>
    <maxSpillMiB>64</maxSpillMiB>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>700</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
    </GUI>
    <mode>MAPPED_INPUTS</mode>
    <basketMode>FROM_FIELD</basketMode>
    <inputs>
      <input>
        <transformName>target copies</transformName>
        <className>HopIli_Collections_V1.Data.Target</className>
        <objectIdField>_ili_tid</objectIdField>
        <basketIdField>_ili_bid</basketIdField>
        <fields>
          <field>
            <sourceField>Name</sourceField>
            <targetPath>Name</targetPath>
          </field>
        </fields>
      </input>
      <input>
        <transformName>items</transformName>
        <className>HopIli_Collections_V1.Data.Item</className>
        <objectIdField>_ili_tid</objectIdField>
        <basketIdField>_ili_bid</basketIdField>
        <sourceObjectField>_ili_source_object</sourceObjectField>
        <fields />
      </input>
    </inputs>
  </transform>
  <order>
    <hop>
      <from>targets</from>
      <to>target copies</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>target copies</from>
      <to>output</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>items</from>
      <to>output</to>
      <enabled>Y</enabled>
    </hop>
  </order>
</pipeline>
