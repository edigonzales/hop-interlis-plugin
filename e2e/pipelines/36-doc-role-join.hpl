<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>36-doc-role-join</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
  </info>
  <transform>
    <type>INTERLIS_INPUT</type>
    <name>Gebaeude input</name>
    <fileName>${E2E_INPUT_DIR}/rolle-transfer.xtf</fileName>
    <modelNames>DemoRolle</modelNames>
    <modelDirectories>${E2E_INPUT_DIR}</modelDirectories>
    <className>DemoRolle.Verwaltung.Gebaeude</className>
    <includeTid>Y</includeTid>
    <includeBid>Y</includeBid>
    <includeClassName>N</includeClassName>
    <includeTopicName>N</includeTopicName>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>100</xloc><yloc>100</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>Main fields</name>
    <fields>
      <select_unspecified>N</select_unspecified>
      <meta><name>_ili_tid</name><type>String</type><length>-1</length><precision>-1</precision></meta>
      <meta><name>_ili_bid</name><type>String</type><length>-1</length><precision>-1</precision></meta>
      <meta><name>Name</name><type>String</type><length>-1</length><precision>-1</precision></meta>
      <meta><name>Geometrie</name><type>String</type><length>-1</length><precision>-1</precision></meta>
      <meta><name>Gemeinde_ref</name><type>String</type><length>-1</length><precision>-1</precision></meta>
    </fields>
    <distribute>N</distribute><copies>1</copies>
    <GUI><xloc>250</xloc><yloc>100</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning><attributes/>
  </transform>
  <transform>
    <type>INTERLIS_ROLE_JOIN</type>
    <name>INTERLIS Role Join</name>
    <mainInputTransform>Main fields</mainInputTransform>
    <lookupInputTransform>Gemeinde input</lookupInputTransform>
    <modelNames>DemoRolle</modelNames>
    <modelDirectories>${E2E_INPUT_DIR}</modelDirectories>
    <mainClassName>DemoRolle.Verwaltung.Gebaeude</mainClassName>
    <roleName>Gemeinde</roleName>
    <mainReferenceField>Gemeinde_ref</mainReferenceField>
    <lookupTidField>_ili_tid</lookupTidField>
    <prefix>Gemeinde_</prefix>
    <lookupFields>Name</lookupFields>
    <lookupFields>BFS_Nummer</lookupFields>
    <failOnMissingMandatoryReference>Y</failOnMissingMandatoryReference>
    <failOnDuplicateTid>Y</failOnDuplicateTid>
    <maxLookupRows>500000</maxLookupRows>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI><xloc>350</xloc><yloc>100</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TextFileOutput</type>
    <name>Text file output</name>
    <compression>None</compression>
    <create_parent_folder>Y</create_parent_folder>
    <separator>;</separator>
    <enclosure/>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>N</enclosure_fix_disabled>
    <header>Y</header>
    <footer>N</footer>
    <format>DOS</format>
    <fileNameInField>N</fileNameInField>
    <ignore_fields>N</ignore_fields>
    <file><name>${E2E_OUTPUT_DIR}/doc-rolle</name><do_not_open_new_file_init>Y</do_not_open_new_file_init><extension>csv</extension><append>N</append><split>N</split><haspartno>N</haspartno><add_date>N</add_date><add_time>N</add_time><SpecifyFormat>N</SpecifyFormat><add_to_result_filenames>Y</add_to_result_filenames><pad>N</pad><fast_dump>N</fast_dump></file>
    <fields/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI><xloc>600</xloc><yloc>100</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>INTERLIS_INPUT</type>
    <name>Gemeinde input</name>
    <fileName>${E2E_INPUT_DIR}/rolle-transfer.xtf</fileName>
    <modelNames>DemoRolle</modelNames>
    <modelDirectories>${E2E_INPUT_DIR}</modelDirectories>
    <className>DemoRolle.Verwaltung.Gemeinde</className>
    <includeTid>Y</includeTid>
    <includeBid>Y</includeBid>
    <includeClassName>N</includeClassName>
    <includeTopicName>N</includeTopicName>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>100</xloc><yloc>300</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <order>
    <hop><from>Gebaeude input</from><to>Main fields</to><enabled>Y</enabled></hop>
    <hop><from>Main fields</from><to>INTERLIS Role Join</to><enabled>Y</enabled></hop>
    <hop><from>INTERLIS Role Join</from><to>Text file output</to><enabled>Y</enabled></hop>
    <hop><from>Gemeinde input</from><to>INTERLIS Role Join</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
