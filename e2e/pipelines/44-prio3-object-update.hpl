<pipeline>
  <info>
    <name>44-prio3-object-update</name>
    <pipeline_type>Normal</pipeline_type>
    <parameters />
    <size_rowset>1</size_rowset>
  </info>
  <transform>
    <name>items</name>
    <type>INTERLIS_INPUT</type>
    <modelNames>HopIli_P1_V1</modelNames>
    <modelDirectories>${E2E_INPUT_DIR}</modelDirectories>
    <className>HopIli_P1_V1.Data.Item</className>
    <fileName>${E2E_INPUT_DIR}/p1-3d.xtf</fileName>
    <includeTid>Y</includeTid>
    <includeBid>Y</includeBid>
    <selectFields>Y</selectFields>
    <selectedFields>Details.Note</selectedFields>
    <keepSourceObject>N</keepSourceObject>
    <sourceObjectFieldName>_ili_source_object</sourceObjectFieldName>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>output</name>
    <type>INTERLIS_UPDATE</type>
    <modelNames>HopIli_P1_V1</modelNames>
    <modelDirectories>${E2E_INPUT_DIR}</modelDirectories>
    <fileName>${E2E_OUTPUT_DIR}/prio3-update.xtf</fileName>
    <overwrite>Y</overwrite>
    <validateBeforePublish>Y</validateBeforePublish>
    <bufferMemoryMiB>1</bufferMemoryMiB>
    <spillDirectory>${E2E_OUTPUT_DIR}</spillDirectory>
    <maxSpillMiB>64</maxSpillMiB>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>700</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
    </GUI>
    <originalFile>${E2E_INPUT_DIR}/p1-3d.xtf</originalFile>
    <inputs>
      <input>
        <transformName>items</transformName>
        <className>HopIli_P1_V1.Data.Item</className>
        <objectIdField>_ili_tid</objectIdField>
        <basketIdField>_ili_bid</basketIdField>
        <fields>
          <field>
            <sourceField>Details_Note</sourceField>
            <targetPath>Name</targetPath>
          </field>
        </fields>
      </input>
    </inputs>
  </transform>
  <order>
    <hop>
      <from>items</from>
      <to>output</to>
      <enabled>Y</enabled>
    </hop>
  </order>
</pipeline>
